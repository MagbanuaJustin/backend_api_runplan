#-----------------------------------------------------------------------------
# RunPlan API - environment template
#
# Copy to .env (never committed; .gitignore covers it) and fill in what you
# actually use. Every integration below is OPTIONAL: leaving a block blank or
# its *_ENABLED flag false means the feature reports "not configured" and the
# core planner, dashboard and manual activity logging keep working. That is
# requirement NFR-04 / section 7.3 of the project spec, not a convenience.
#
# Generate a secret with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#-----------------------------------------------------------------------------

#--- Application -------------------------------------------------------------
APP_ENV=development
MIGRATION_ENABLED=false

#--- Database (Laragon/MySQL in development) ---------------------------------
# DB_NAME is the single source of truth for which schema migrations run
# against. In development this is runplandb; do not hardcode it elsewhere.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=runplandb
# Optional private CA (also used by outbound HTTP calls). Store as a path
# relative to the project root, e.g. app/config/certs/aiven-ca.pem
DB_SSL_CA=

#--- Tokens ------------------------------------------------------------------
# Both must be >= 32 characters or Api.php refuses to boot.
JWT_SECRET=
REFRESH_TOKEN_KEY=

#--- CORS --------------------------------------------------------------------
# Comma-separated exact origins, no trailing slash.
# Vite dev server is 5173; the API is expected on 3000.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

#--- Anthropic Claude (plan drafting + AI feedback) --------------------------
# The key stays server-side, always. Never put it in the React bundle.
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_TIMEOUT=25
ANTHROPIC_MAX_TOKENS=3000
# Hard ceiling so testing cannot quietly spend a month's credit
ANTHROPIC_MONTHLY_CALL_CAP=500

#--- OpenWeatherMap ------------------------------------------------------------
# forecast16 = free, 5-day horizon. onecall = 8-day, needs a paid plan.
# The horizon is published to the UI so it can say "no forecast that far out"
# rather than inventing one.
OWM_ENABLED=false
OWM_API_KEY=
OWM_PRODUCT=forecast16
OWM_FORECAST_DAYS=5
OWM_CACHE_MINUTES=60

#--- Google Calendar (opt-in event sync) --------------------------------------
# Redirect URI must be registered in Google Cloud Console exactly as set here.
GCAL_ENABLED=false
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
# Must match Google Cloud Console exactly, and be reachable by the browser:
# e.g. http://localhost/runplan_lavalust_api/public/calendar/callback
GCAL_REDIRECT_URI=
# 32 random bytes as hex; encrypts OAuth refresh tokens at rest.
GCAL_TOKEN_AAD=
GCAL_EVENT_MINUTES=60
# IANA timezone used for session event times, e.g. Asia/Manila or America/New_York
GCAL_TIMEZONE=Asia/Manila
# SPA page the callback redirects back to (receives ?calendar=connected|denied|...)
GCAL_RETURN_URL=http://localhost:5173/account

#--- Push reminders -------------------------------------------------------------
# PUSH_DRIVER=vapid  -> standard Web Push, no vendor account, works on localhost
# PUSH_DRIVER=fcm    -> Firebase Web Push, as named in the project spec
PUSH_ENABLED=false
PUSH_DRIVER=vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

#--- Google Sign-In / Sign-Up ----------------------------------------------------
# Web client ID only. The client SECRET is never needed for ID-token verification
# and must not be configured here.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=

#--- Google reCAPTCHA (register + password recovery) -----------------------------
# version=v3 (invisible, score) | v2 (checkbox) | enterprise (keyless + project)
# Backend verification is mandatory: a frontend "completed" flag proves nothing.
# When this is enabled, an unverifiable challenge must BLOCK the form.
RECAPTCHA_ENABLED=false
RECAPTCHA_VERSION=v3
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_MIN_SCORE=0.5
