#-----------------------------------------------------------------------------
# RunPlan API - environment template
#
# Copy to .env and enter your own values. Never commit the real .env file.
# Optional integrations remain disabled until enabled and configured.
#
# Generate application secrets with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#-----------------------------------------------------------------------------

#--- Application -------------------------------------------------------------
APP_ENV=development
MIGRATION_ENABLED=false

#--- Database ---------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=runplandb
DB_SSL_CA=

#--- Tokens -----------------------------------------------------------------
JWT_SECRET=
REFRESH_TOKEN_KEY=

#--- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

#--- Groq (plan drafting, AI feedback, and chat) -----------------------------
# The API key must stay on the server; never add it to the React/Vite app.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URI=https://api.groq.com/openai/v1
GROQ_TIMEOUT=20
GROQ_MAX_TOKENS=700
GROQ_MONTHLY_CALL_CAP=500

#--- OpenWeatherMap ----------------------------------------------------------
OWM_ENABLED=false
OWM_API_KEY=
OWM_PRODUCT=forecast16
OWM_FORECAST_DAYS=5
OWM_CACHE_MINUTES=60

#--- Google Calendar (opt-in event sync) -------------------------------------
GCAL_ENABLED=false
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REDIRECT_URI=
GCAL_TOKEN_AAD=
GCAL_EVENT_MINUTES=60
GCAL_TIMEZONE=Asia/Manila
GCAL_RETURN_URL=http://localhost:5173/calendar

#--- Push reminders ----------------------------------------------------------
PUSH_ENABLED=false
PUSH_DRIVER=vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NOTIFICATION_WORKER_TOKEN=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

#--- Google Sign-In / Sign-Up -----------------------------------------------
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_TIMEOUT=10

#--- Google reCAPTCHA Enterprise --------------------------------------------
RECAPTCHA_ENABLED=false
RECAPTCHA_VERSION=checkbox
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1
RECAPTCHA_TIMEOUT=10